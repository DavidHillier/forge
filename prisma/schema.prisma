generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Units {
  metric
  imperial
}

enum Phase {
  BUILD_UP
  MAIN_COURSE
}

enum TrainingLoad {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  programmeStartDate DateTime
  units              Units               @default(metric)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  completions        WorkoutCompletion[]
  readinessChecks    ReadinessCheck[]
  bodyMetrics        BodyMetric[]
  weeklyReflections  WeeklyReflection[]
  consents           UserConsent[]
  exportRequests     DataExportRequest[]
  substitutions      WorkoutSubstitution[]
  exerciseWeights    ExerciseWeight[]
  equipmentProfile   Json                  @default("[]") // string[]
}

model Programme {
  id          String   @id @default(cuid())
  name        String
  description String
  totalWeeks  Int
  totalDays   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  weeks       Week[]
}

model Week {
  id                   String    @id @default(cuid())
  programmeId          String
  weekNumber           Int       @unique
  phase                Phase
  title                String
  theme                String
  objective            String
  circuitCount         Int?
  mainCourseWeekNumber Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  programme            Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  workouts             Workout[]
}

model Workout {
  id              String              @id @default(cuid())
  weekId          String
  dayNumber       Int
  title           String
  type            String
  durationMinutes Int
  intensity       String
  circuitCount    Int?
  equipment       Json
  description     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  week            Week                  @relation(fields: [weekId], references: [id], onDelete: Cascade)
  blocks          WorkoutBlock[]
  completions     WorkoutCompletion[]
  readinessChecks ReadinessCheck[]
  substitutions   WorkoutSubstitution[]
  exerciseWeights ExerciseWeight[]

  @@unique([weekId, dayNumber])
}

model WorkoutBlock {
  id              String     @id @default(cuid())
  workoutId       String
  name            String
  order           Int
  durationMinutes Int
  blockType       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  workout         Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises       Exercise[]
}

model Exercise {
  id             String       @id @default(cuid())
  workoutBlockId String
  name           String
  order          Int
  workSeconds    Int
  restSeconds    Int
  rounds         Int
  formCues       Json
  safetyCue      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workoutBlock   WorkoutBlock @relation(fields: [workoutBlockId], references: [id], onDelete: Cascade)
}

model WorkoutCompletion {
  id                String       @id @default(cuid())
  userId            String
  workoutId         String
  completedAt       DateTime     @default(now())
  totalSeconds      Int
  circuitsCompleted Int
  roundsCompleted   Int
  effortScore       Int
  trainingLoad      TrainingLoad
  notes             String?
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout           Workout               @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  substitutions     WorkoutSubstitution[]

  @@index([userId, completedAt])
}

model ReadinessCheck {
  id             String   @id @default(cuid())
  userId         String
  workoutId      String
  date           DateTime @default(now())
  sleepQuality   String
  soreness       String
  energyLevel    String
  timeAvailable  String
  recommendation String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout        Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

model BodyMetric {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  weight           Float?
  waist            Float?
  restingHeartRate Int?
  note             String?
  progressPhotoUrl String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReflection {
  id         String   @id @default(cuid())
  userId     String
  weekNumber Int
  energy     Int
  sleep      Int
  soreness   Int
  motivation Int
  notes      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber])
}

model UserConsent {
  id                String   @id @default(cuid())
  userId            String
  privacyAcceptedAt DateTime
  termsAcceptedAt   DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataExportRequest {
  id          String    @id @default(cuid())
  userId      String
  status      String    @default("requested")
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Exercise Catalogue ──────────────────────────────────────────────────────

model CanonicalExercise {
  id               String               @id @default(cuid())
  name             String               @unique
  description      String               @default("")
  movementPattern  String
  primaryMuscles   Json                 // string[]
  secondaryMuscles Json                 @default("[]") // string[]
  equipment        Json                 // string[]
  difficulty       String               // "beginner" | "moderate" | "advanced"
  impactLevel      String               // "low" | "moderate" | "high"
  jointStressLevel String               // "low" | "moderate" | "high"
  isCanonical      Boolean              @default(false)
  formCues         Json                 @default("[]") // string[]
  safetyCue        String               @default("Stop if you feel sharp pain or dizziness.")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  asCanonical      ExerciseSubstitute[] @relation("CanonicalExercise")
  asSubstitute     ExerciseSubstitute[] @relation("SubstituteExercise")
}

model ExerciseSubstitute {
  id                   String            @id @default(cuid())
  canonicalExerciseId  String
  substituteExerciseId String
  substitutionReasons  Json              // SubstitutionReason[]
  matchQuality         String            // "excellent" | "good" | "fair"
  intensityChange      String            @default("same") // "lower" | "same" | "higher"
  difficultyChange     String            @default("same") // "easier" | "same" | "harder"
  recommendationRank   Int               @default(5)
  scalingNote          String?
  cautionNote          String?
  isAdvanced           Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  canonical            CanonicalExercise @relation("CanonicalExercise", fields: [canonicalExerciseId], references: [id], onDelete: Cascade)
  substitute           CanonicalExercise @relation("SubstituteExercise", fields: [substituteExerciseId], references: [id], onDelete: Cascade)

  @@unique([canonicalExerciseId, substituteExerciseId])
  @@index([canonicalExerciseId])
}

model WorkoutSubstitution {
  id                      String             @id @default(cuid())
  userId                  String
  workoutId               String
  workoutCompletionId     String?
  originalExerciseName    String
  substitutedExerciseName String
  substitutionReason      String
  createdAt               DateTime           @default(now())
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout                 Workout            @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  completion              WorkoutCompletion? @relation(fields: [workoutCompletionId], references: [id], onDelete: SetNull)

  @@index([userId, workoutId])
}

model ExerciseWeight {
  id           String   @id @default(cuid())
  userId       String
  workoutId    String
  exerciseName String   // base display name, e.g. "Squat"
  weight       Float
  loggedAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout      Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseName])
  @@index([userId, workoutId])
}
